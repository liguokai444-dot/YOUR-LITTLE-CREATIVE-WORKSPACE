{
  "name": "html-studio",
  "version": "1.0.0",
  "description": "A private, local-first HTML playground",
  "scripts": {
    "test": "playwright test",
    "dev": "node scripts/vite-task.mjs dev",
    "build": "node scripts/vite-task.mjs build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node scripts/launcher.cjs start",
    "test:e2e": "playwright test",
    "start:lan": "node scripts/launcher.cjs start --lan",
    "stop": "node scripts/launcher.cjs stop",
    "status": "node scripts/launcher.cjs status",
    "serve": "node scripts/serve-studio.mjs",
    "test:service": "node --test tests/service.test.mjs",
    "check:privacy": "node scripts/privacy-check.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
