    "@codemirror/search": "^6.7.2",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "lucide-react": "^1.65.0",
    "prettier": "^3.9.10",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.17",
